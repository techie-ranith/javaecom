# Copy to .env in the repo root for docker compose (optional overrides)
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=perfume
MYSQL_PORT=3306
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DDL_AUTO=update
JWT_SECRET=change-this-development-secret-key-at-least-32-chars
JWT_EXPIRATION=86400000
SEED_ENABLED=true
